* {
    
    bg0: #111318;
    bg1: #204876;
    fg0: #e1e2e9;
    
    accent-color: #a4c9fe;
    urgent-color: #00315d;
    
    text-color: @fg0;
    
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 480;
    background-color: @bg0;
    border-radius: 8px;
    border: 1px;          
    border-color: @bg1;
}

inputbar {
    spacing: 8px;
    padding: 12px;
    background-color: @bg1;
    border-radius: 8px 8px 0 0;
    border: 0px;
}

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

prompt {
    text-color: @accent-color;
}

entry {
    placeholder-text: "Search...";
    placeholder-color: @fg0;
}

textbox {
    padding: 8px;
    background-color: @bg1;
}

listview {
    padding: 8px 0;
    lines: 8;
    columns: 5;
    fixed-height: false;
    scrollbar: true;
    border: 0px;   
    border-top: 0px;     
}

element {
    padding: 10px;
    spacing: 12px;
}

/* Обычные элементы (четные) */
element normal normal {
    text-color: @fg0;
    background-color: @bg1;
}

/* Альтернативные элементы (нечетные) - ИСПРАВЛЕНО */
element alternate normal {
    text-color: @fg0;
    background-color: @bg0;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

/* Выбранные элементы */
element selected {
    text-color: @bg0;
}

element selected normal,
element selected alternate {
    background-color: @accent-color;
    text-color: @bg0;
}

element selected urgent {
    background-color: @urgent-color;
}

element-icon {
    size: 1em;
}

element-text {
    text-color: inherit;
}

mode-switch {
    padding: 8px;
    background-color: @bg1;
}

button {
    padding: 8px;
    margin: 4px;
}

error-message {
    background-color: @urgent-color;
    text-color: @bg0;
    padding: 10px;
}
